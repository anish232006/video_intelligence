# Environment Variables — Copy to .env and fill in your values
# DO NOT commit real API keys to version control

# ─── LLM API Keys (optional — system works without them) ───
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── Model Configuration (override config.yaml) ────────────
# YOLO_MODEL=yolov8n.pt
# CLIP_MODEL=ViT-B-32
# DEVICE=cuda

# ─── Database Path ──────────────────────────────────────────
# DB_PATH=data/app.db

# ─── Feature Flags ──────────────────────────────────────────
# USE_VLM_VERIFICATION=false
# ENABLE_CROSS_CAMERA_REID=false
